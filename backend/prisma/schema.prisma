generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String     @id @default(uuid())
  nome      String
  createdAt DateTime   @default(now())
  usuarios  Usuario[]
  operacoes Operacao[]
  playbooks Playbook[]
}

model Operacao {
  id            String           @id @default(uuid())
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id])
  nome          String
  descricao     String?
  createdAt     DateTime         @default(now())
  departamentos Departamento[]
  fluxos        Fluxo[]
  atividades    Atividade[]
  casos         Caso[]
  membros       OperacaoMembro[]
  playbooks     Playbook[]

  @@index([empresaId])
}

model OperacaoMembro {
  id             String        @id @default(uuid())
  operacaoId     String
  operacao       Operacao      @relation(fields: [operacaoId], references: [id])
  usuarioId      String
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  papel          String        @default("operacional")

  @@unique([operacaoId, usuarioId])
}

model Usuario {
  id                    String                 @id @default(uuid())
  nome                  String
  email                 String                 @unique
  senha                 String
  funcao                String
  nivelAcesso           String                 @default("operacional")
  empresaId             String
  empresa               Empresa                @relation(fields: [empresaId], references: [id])
  createdAt             DateTime               @default(now())
  membros               OperacaoMembro[]
  atividades            Atividade[]            @relation("Responsavel")
  participacoes         AtividadeResponsavel[]
  solicitacoes          Atividade[]            @relation("Solicitante")
  criadas               Atividade[]            @relation("Criador")
  movimentacoes         MovimentacaoEtapa[]
  casos                 Caso[]
  playbooks             Playbook[]             @relation("PlaybookCriador")
  aprovacoesSolicitadas AprovacaoEtapa[]       @relation("AprovacaoSolicitante")
  aprovacoesDecididas   AprovacaoEtapa[]       @relation("AprovacaoDecisor")
}

model Departamento {
  id            String           @id @default(uuid())
  operacaoId    String
  operacao      Operacao         @relation(fields: [operacaoId], references: [id])
  nome          String
  atividades    Atividade[]
  etapas        EtapaFluxo[]
  casos         Caso[]
  membros       OperacaoMembro[]
  playbookItens PlaybookItem[]

  @@index([operacaoId])
}

model Fluxo {
  id         String       @id @default(uuid())
  operacaoId String
  operacao   Operacao     @relation(fields: [operacaoId], references: [id])
  nome       String
  descricao  String?
  createdAt  DateTime     @default(now())
  etapas     EtapaFluxo[]
  atividades Atividade[]

  @@index([operacaoId])
}

model EtapaFluxo {
  id              String              @id @default(uuid())
  fluxoId         String
  fluxo           Fluxo               @relation(fields: [fluxoId], references: [id])
  nome            String
  ordem           Int
  equipeId        String
  requerAprovacao Boolean             @default(false)
  equipe          Departamento        @relation(fields: [equipeId], references: [id])
  atividades      Atividade[]         @relation("EtapaAtual")
  movOrigem       MovimentacaoEtapa[] @relation("EtapaOrigem")
  movDestino      MovimentacaoEtapa[] @relation("EtapaDestino")
  aprovacoes      AprovacaoEtapa[]
  playbookItens   PlaybookItem[]

  @@unique([fluxoId, ordem])
}

model Atividade {
  id            String                 @id @default(uuid())
  operacaoId    String
  operacao      Operacao               @relation(fields: [operacaoId], references: [id])
  titulo        String
  descricao     String?
  responsavelId String
  responsavel   Usuario                @relation("Responsavel", fields: [responsavelId], references: [id])
  solicitanteId String?
  solicitante   Usuario?               @relation("Solicitante", fields: [solicitanteId], references: [id])
  criadoPorId   String?
  criadoPor     Usuario?               @relation("Criador", fields: [criadoPorId], references: [id])
  equipeId      String?
  equipe        Departamento?          @relation(fields: [equipeId], references: [id])
  fluxoId       String?
  fluxo         Fluxo?                 @relation(fields: [fluxoId], references: [id])
  etapaAtualId  String?
  etapaAtual    EtapaFluxo?            @relation("EtapaAtual", fields: [etapaAtualId], references: [id])
  status        String                 @default("pendente")
  prioridade    String                 @default("media")
  prazoEstimado DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?
  tempoGastoMin Int?
  createdAt     DateTime               @default(now())
  deletedAt     DateTime?
  historico     Historico[]
  movimentacoes MovimentacaoEtapa[]
  casos         Caso[]
  responsaveis  AtividadeResponsavel[]
  aprovacoes    AprovacaoEtapa[]

  @@index([operacaoId])
}

model AtividadeResponsavel {
  id          String    @id @default(uuid())
  atividadeId String
  atividade   Atividade @relation(fields: [atividadeId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([atividadeId, usuarioId])
}

model MovimentacaoEtapa {
  id             String      @id @default(uuid())
  atividadeId    String
  atividade      Atividade   @relation(fields: [atividadeId], references: [id])
  etapaOrigemId  String?
  etapaOrigem    EtapaFluxo? @relation("EtapaOrigem", fields: [etapaOrigemId], references: [id])
  etapaDestinoId String?
  etapaDestino   EtapaFluxo? @relation("EtapaDestino", fields: [etapaDestinoId], references: [id])
  tipo           String      @default("avanco")
  movidoPorId    String
  movidoPor      Usuario     @relation(fields: [movidoPorId], references: [id])
  obs            String?
  timestamp      DateTime    @default(now())
}

model Historico {
  id              String    @id @default(uuid())
  atividadeId     String
  atividade       Atividade @relation(fields: [atividadeId], references: [id])
  usuarioId       String
  acaoExecutada   String
  campo           String?
  valorAnterior   String?
  valorNovo       String?
  alteracaoEstado String?
  timestamp       DateTime  @default(now())
}

model Caso {
  id              String        @id @default(uuid())
  operacaoId      String
  operacao        Operacao      @relation(fields: [operacaoId], references: [id])
  titulo          String
  descricao       String
  status          String        @default("aberto")
  atividadeId     String?
  atividade       Atividade?    @relation(fields: [atividadeId], references: [id])
  equipeId        String?
  equipe          Departamento? @relation(fields: [equipeId], references: [id])
  registradoPorId String
  registradoPor   Usuario       @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime      @default(now())
  anexos          Anexo[]

  @@index([operacaoId])
}

model Anexo {
  id        String   @id @default(uuid())
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id])
  nome      String
  caminho   String
  mime      String?
  createdAt DateTime @default(now())
}

model Playbook {
  id          String         @id @default(uuid())
  empresaId   String
  empresa     Empresa        @relation(fields: [empresaId], references: [id])
  operacaoId  String?
  operacao    Operacao?      @relation(fields: [operacaoId], references: [id])
  nome        String
  descricao   String?
  criadoPorId String
  criadoPor   Usuario        @relation("PlaybookCriador", fields: [criadoPorId], references: [id])
  itens       PlaybookItem[]
  frequencia  String?
  proximaEm   DateTime?
  ultimaEm    DateTime?
  ativa       Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([empresaId])
  @@index([operacaoId])
}

model PlaybookItem {
  id         String        @id @default(uuid())
  playbookId String
  playbook   Playbook      @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  titulo     String
  descricao  String?
  prioridade String        @default("media")
  equipeId   String?
  equipe     Departamento? @relation(fields: [equipeId], references: [id])
  etapaId    String?
  etapa      EtapaFluxo?   @relation(fields: [etapaId], references: [id])
  offsetDias Int           @default(0)
  ordem      Int           @default(0)

  @@index([playbookId])
}

model AprovacaoEtapa {
  id              String     @id @default(uuid())
  atividadeId     String
  atividade       Atividade  @relation(fields: [atividadeId], references: [id])
  etapaId         String
  etapa           EtapaFluxo @relation(fields: [etapaId], references: [id])
  status          String     @default("pendente")
  solicitadoPorId String
  solicitadoPor   Usuario    @relation("AprovacaoSolicitante", fields: [solicitadoPorId], references: [id])
  decididoPorId   String?
  decididoPor     Usuario?   @relation("AprovacaoDecisor", fields: [decididoPorId], references: [id])
  comentario      String?
  createdAt       DateTime   @default(now())
  decididoEm      DateTime?

  @@unique([atividadeId, etapaId])
}
